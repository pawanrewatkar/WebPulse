# Copy to .env.local (used by the web app, worker and CLI).

# Where the SQLite database and stored captures live (relative to project root).
DATA_DIR=./data

# 32+ character secret used to encrypt stored website login credentials (AES-256-GCM).
# If unset, a random key is generated once and saved to DATA_DIR/secret.key.
# APP_SECRET=

# SSRF protection: private/loopback/link-local addresses are blocked by default.
# Comma-separated hostnames/IPs that may be crawled even though they resolve to private addresses
# (e.g. a staging server on your LAN, or localhost for testing).
ALLOWED_PRIVATE_HOSTS=localhost,127.0.0.1
# Set to "true" to allow ALL private network targets (not recommended).
ALLOW_PRIVATE_NETWORKS=false

# Worker polling interval and log level (debug|info|warn|error)
WORKER_POLL_MS=2000
LOG_LEVEL=info
